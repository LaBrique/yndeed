# ===========================================
# Configuration Yndeed - EXEMPLE
# ===========================================
# Copiez ce fichier vers .env et modifiez les valeurs

# Django
DEBUG=False
SECRET_KEY=CHANGEZ-MOI-EN-PRODUCTION
ALLOWED_HOSTS=localhost,127.0.0.1,yndeed.ynov

# Base de données PostgreSQL
DATABASE_NAME=yndeed
DATABASE_USER=yndeed
DATABASE_PASSWORD=CHANGEZ-MOI-EN-PRODUCTION

# Email (Gmail SMTP)
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-app-password

# Google OAuth (depuis Google Cloud Console)
# 1. Créer un projet: https://console.cloud.google.com/
# 2. Activer Google+ API et Google Identity
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter les URIs de redirection autorisés:
#    - http://localhost:8000/accounts/google/login/callback/
#    - https://votredomaine.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CSRF
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://yndeed.ynov
